rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isCreatingOwnDocument() {
      return isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    function isUpdatingOwnDocument() {
      return isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    function isValidConnectionForOwner(connectionId) {
      return connectionId is string
        && exists(/databases/$(database)/documents/connections/$(connectionId))
        && get(/databases/$(database)/documents/connections/$(connectionId)).data.ownerId == request.auth.uid;
    }

    function hasOnlyUserFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'name',
        'email',
        'phone',
        'companyName',
        'profileCompleted',
        'authProviders',
        'emailUniqueValue',
        'phoneUniqueValue',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasNoUserUniqueFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'emailUniqueValue',
        'phoneUniqueValue'
      ]);
    }

    function keepsUserUniqueFieldsUnchanged() {
      return (
        (
          !resource.data.keys().hasAny(['emailUniqueValue'])
          && !request.resource.data.keys().hasAny(['emailUniqueValue'])
        )
        ||
        (
          resource.data.keys().hasAny(['emailUniqueValue'])
          && request.resource.data.keys().hasAny(['emailUniqueValue'])
          && request.resource.data.emailUniqueValue == resource.data.emailUniqueValue
        )
      )
      &&
      (
        (
          !resource.data.keys().hasAny(['phoneUniqueValue'])
          && !request.resource.data.keys().hasAny(['phoneUniqueValue'])
        )
        ||
        (
          resource.data.keys().hasAny(['phoneUniqueValue'])
          && request.resource.data.keys().hasAny(['phoneUniqueValue'])
          && request.resource.data.phoneUniqueValue == resource.data.phoneUniqueValue
        )
      );
    }

    function hasOnlyConnectionFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'name',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasOnlyContactFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'connectionId',
        'name',
        'phone',
        'email',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasOnlyMessageFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'connectionId',
        'contactIds',
        'contactEmails',
        'contactPhones',
        'content',
        'status',
        'scheduledAt',
        'sentAt',
        'sendEmailCopy',
        'sendWhatsappCopy',
        'createdAt',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId);

      allow create: if isOwnUser(userId)
        && hasOnlyUserFields()
        && hasNoUserUniqueFieldsOnCreate()
        && request.resource.data.id == userId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.companyName is string
        && request.resource.data.profileCompleted is bool
        && request.resource.data.authProviders is list;

      allow update: if isOwnUser(userId)
        && resource.data.ownerId == request.auth.uid
        && hasOnlyUserFields()
        && keepsUserUniqueFieldsUnchanged()
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.companyName is string
        && request.resource.data.profileCompleted is bool
        && request.resource.data.authProviders is list;

      allow delete: if false;
    }

    match /user_unique_fields/{fieldId} {
      allow read, write: if false;
    }

    match /connections/{connectionId} {
      allow read, delete: if isOwner(resource.data.ownerId);

      allow create: if isCreatingOwnDocument()
        && hasOnlyConnectionFields()
        && request.resource.data.id == connectionId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow update: if isUpdatingOwnDocument()
        && hasOnlyConnectionFields()
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == connectionId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    match /contacts/{contactId} {
      allow read, delete: if isOwner(resource.data.ownerId);

      allow create: if isCreatingOwnDocument()
        && hasOnlyContactFields()
        && request.resource.data.id == contactId
        && isValidConnectionForOwner(request.resource.data.connectionId)
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email.size() <= 160;

      allow update: if isUpdatingOwnDocument()
        && hasOnlyContactFields()
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == contactId
        && isValidConnectionForOwner(request.resource.data.connectionId)
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email.size() <= 160;
    }

    match /messages/{messageId} {
      allow read, delete: if isOwner(resource.data.ownerId);

      allow create: if isCreatingOwnDocument()
        && hasOnlyMessageFields()
        && request.resource.data.id == messageId
        && isValidConnectionForOwner(request.resource.data.connectionId)
        && request.resource.data.contactIds is list
        && request.resource.data.contactIds.size() > 0
        && request.resource.data.contactIds.size() <= 200
        && request.resource.data.contactEmails is list
        && request.resource.data.contactEmails.size() <= 200
        && request.resource.data.contactPhones is list
        && request.resource.data.contactPhones.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.status in ['scheduled', 'sent']
        && request.resource.data.sendEmailCopy is bool
        && request.resource.data.sendWhatsappCopy is bool;

      allow update: if isUpdatingOwnDocument()
        && hasOnlyMessageFields()
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == messageId
        && isValidConnectionForOwner(request.resource.data.connectionId)
        && request.resource.data.contactIds is list
        && request.resource.data.contactIds.size() > 0
        && request.resource.data.contactIds.size() <= 200
        && request.resource.data.contactEmails is list
        && request.resource.data.contactEmails.size() <= 200
        && request.resource.data.contactPhones is list
        && request.resource.data.contactPhones.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.status in ['scheduled', 'sent']
        && request.resource.data.sendEmailCopy is bool
        && request.resource.data.sendWhatsappCopy is bool;
    }
  }
}